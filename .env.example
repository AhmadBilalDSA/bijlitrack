# ==========================================
# BijliTrack - Environment Configuration
# ==========================================

# MongoDB Atlas Connection URI (Required)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/bijlitrack?retryWrites=true&w=majority

# JWT Secret for Session Authentication (Required)
JWT_SECRET=your-secure-random-jwt-secret-key-here

# Optional: Groq API Key for AI Analysis Reports (free tier at console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key

# Optional: Secret token to authorize Vercel Cron requests
CRON_SECRET=your-random-cron-secret-token

# Optional: SMTP Email service for password reset emails
APP_NAME=BijliTrack
MAIL_FROM="BijliTrack <no-reply@example.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password

# Optional: Frontend API URL override (defaults to same-origin /api)
# NEXT_PUBLIC_API_URL=https://your-domain.vercel.app/api
